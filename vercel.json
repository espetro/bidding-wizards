{
  "rewrites": [
    { "source": "/", "has": [{ "type": "header", "key": "accept", "value": "(.*)text/markdown(.*)" }], "destination": "/index.md" },
    { "source": "/bid", "destination": "/index.html" },
    { "source": "/bid/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Link", "value": "</llms.txt>; rel=\"describedby\"; type=\"text/plain\", </llms-full.txt>; rel=\"describedby\"; type=\"text/plain\", </sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\"" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    { "source": "/(llms|llms-full|robots).txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] },
    { "source": "/index.md", "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }] }
  ]
}
