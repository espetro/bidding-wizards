{
  "name": "wizbid",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build && pnpm run deck",
    "deck": "marp pitch/slides.md -o dist/pitch.html --html --no-stdin",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.node.json --pretty false"
  },
  "dependencies": {
    "@ai-sdk/typesafe-ai": "3.0.38",
    "@fontsource-variable/inter": "^5.2.8",
    "ai": "7.0.170",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.5.1",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
